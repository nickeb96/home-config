# vim: filetype=gitconfig

[Init]
	DefaultBranch = master
	TemplateDir = ~/.config/git/template
[Core]
	IgnoreCase = true
	Eol = lf
	Whitespace = blank-at-eol,space-before-tab,-indent-with-non-tab,tab-in-indent,-blank-at-eof,cr-at-eol,incomplete-line,tabwidth=4
[Push]
	AutoSetupRemote = true
[Pull]
	Rebase = true
[Checkout]
	DefaultRemote = origin
[Tag]
	Sort = v:refname
[Branch]
	Sort = v:refname
[Bash]
	ShowDirtyState = true
	ShowInformativeStatus = true
	ShowUntrackedFiles = true
[Alias]
	ls = ls-tree --format='%(objecttype)\t%(objectmode) %(objectsize:padded)  %(path)' HEAD
	cat = cat-file blob
	ignored = "!cd $PWD/$GIT_PREFIX ; git ls-files --other --ignored --exclude-per-directory=.gitignore --exclude-from=.git/info/exclude --exclude-from=$HOME/.config/git/ignore"
